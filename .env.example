# Copy to ../.env without replacing an existing file.
# Relative filesystem values are resolved from the outer/stuff directory.

## Django settings
RSRVS_UPLDR__SECRET_KEY='local-development-only-change-before-other-use'
RSRVS_UPLDR__DEBUG_JSON=true
RSRVS_UPLDR__ALLOWED_HOSTS_JSON='["localhost", "127.0.0.1"]'

## File-based sessions
RSRVS_UPLDR__SESSION_FILE_PATH='local_data/sessions'

## Static files
RSRVS_UPLDR__STATIC_URL='/static/'
RSRVS_UPLDR__STATIC_ROOT='local_data/static'

## Email and error notifications
RSRVS_UPLDR__ADMINS_JSON='[]'
RSRVS_UPLDR__SERVER_EMAIL='uploader@example.invalid'
RSRVS_UPLDR__EMAIL_HOST='localhost'
RSRVS_UPLDR__EMAIL_PORT=1026

## Logging
RSRVS_UPLDR__LOG_PATH='local_data/uploader.log'
RSRVS_UPLDR__LOG_LEVEL=DEBUG

## Uploaded files
RSRVS_UPLDR__UPLOADS_DIR_PATH='local_data/uploads'
RSRVS_UPLDR__UPLOADS_DIR_URL_ROOT='http://localhost:8001'

## Page header
RSRVS_UPLDR__PATTERN_LIB_HEADER_URL='http://localhost:8001/header.html'
RSRVS_UPLDR__PATTERN_LIB_CACHE_TIMEOUT_IN_HOURS=1
